Film "rgb"
    "string filename" ["test_sphere.exr"]
    "integer xresolution" [128] "integer yresolution" [128]

Sampler "halton"
    "integer pixelsamples" [4]

Integrator "path"

LookAt 0 0 5  0 0 0  0 1 0
Camera "perspective"
    "float fov" [45]

WorldBegin

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [0.8 0.2 0.2]
    Shape "sphere"
        "float radius" [1]
AttributeEnd

LightSource "point"
    "point3 from" [3 5 2]
    "rgb I" [100 100 100]
