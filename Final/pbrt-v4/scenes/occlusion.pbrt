# Occlusion: glass panel in front of 3DGS

Film "rgb"
    "string filename" ["occlusion.exr"]
    "integer xresolution" [800] "integer yresolution" [600]

Sampler "halton"
    "integer pixelsamples" [128]

Integrator "path"

Accelerator "bvh"

LookAt 2 1.5 4  0 0.5 0  0 1 0
Camera "perspective"
    "float fov" [45]

WorldBegin

MakeNamedMaterial "floor"
    "string type" ["diffuse"]
    "rgb reflectance" [0.4 0.4 0.4]
MakeNamedMaterial "gsmat"
    "string type" ["gaussian"]
    "integer sh_degree" [3]
MakeNamedMaterial "glass"
    "string type" ["dielectric"]
    "float eta" [1.5]
    "float roughness" [0.0]

AttributeBegin
    NamedMaterial "floor"
    Shape "bilinearmesh"
        "point3 P" [ -3 0 -3  3 0 -3  3 0 3  -3 0 3 ]
        "integer indices" [0 1 2 3]
AttributeEnd

AttributeBegin
    Translate 0 0.8 -0.5
    NamedMaterial "gsmat"
    Shape "gaussiancloud"
        "string filename" ["assets/lego/point_cloud.ply"]
        "float sigma_cutoff" [2.828]
        "integer sh_degree" [3]
        "bool use_center_depth" [false]
        "string sampling_mode" ["stochastic"]
        "string internal_accel" ["bvh"]
AttributeEnd

AttributeBegin
    NamedMaterial "glass"
    Translate 0 1.0 0.8
    Rotate 15 1 0 0
    Shape "bilinearmesh"
        "point3 P" [ -1.2 0 -0.8  1.2 0 -0.8  -1.2 2.0 -0.8  1.2 2.0 -0.8 ]
        "integer indices" [0 1 2 3]
AttributeEnd

LightSource "distant"
    "rgb L" [1 1 1]
    "float scale" [2.5]
    "point3 from" [0.2 -1 -0.3]
    "point3 to" [0 0 0]
