Film "rgb" "string filename" ["test.exr"] "integer xresolution" [1280] "integer yresolution" [720]
LookAt 0 2 6.0   0 1 0   0 1 0
Camera "perspective" "float fov" [45]
Sampler "halton" "integer pixelsamples" [4]
Integrator "path"

WorldBegin
LightSource "point" "point3 from" [3 5 2] "rgb I" [100 100 100]

AttributeBegin
    Translate 0 1 0
    Rotate 25 1 1 0
    Scale 1 0.1 2.2
    Material "coateddiffuse"
        "rgb reflectance" [0.75 0.25 0.2]
        "float roughness" [0.03]
    Shape "sphere" "float radius" [1]
AttributeEnd
