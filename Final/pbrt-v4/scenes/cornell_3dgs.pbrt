# Cornell Box + 3DGS object (mirror wall + glass sphere + area light)
# Place trained PLY at assets/lego/point_cloud.ply

Film "rgb"
    "string filename" ["cornell_3dgs.exr"]
    "integer xresolution" [800] "integer yresolution" [800]

Sampler "halton"
    "integer pixelsamples" [128]

Integrator "path"

Accelerator "kdtree"

LookAt 0 0 5.5  0 0 0  0 1 0
Camera "perspective"
    "float fov" [40]

WorldBegin

# --- Materials ---
Material "diffuse" "white"
    "rgb reflectance" [0.725 0.71 0.68]
Material "diffuse" "red"
    "rgb reflectance" [0.63 0.065 0.05]
Material "diffuse" "green"
    "rgb reflectance" [0.14 0.45 0.091]
Material "conductor" "mirror"
    "rgb reflectance" [0.9 0.9 0.9]
    "float roughness" [0.001]
Material "dielectric" "glass"
    "float eta" [1.5]
    "float roughness" [0.0]
Material "gaussian" "gsmat"
    "integer sh_degree" [3]

# --- Room ---
AttributeBegin
    Material "white"
    Translate 0 0.01 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1 ]
AttributeEnd

AttributeBegin
    Material "white"
    Translate 0 2 0
    Rotate 180 1 0 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1 ]
AttributeEnd

AttributeBegin
    Material "white"
    Translate 0 1 -1
    Rotate 90 1 0 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1 ]
AttributeEnd

AttributeBegin
    Material "red"
    Translate -1 1 0
    Rotate 90 0 1 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1 ]
AttributeEnd

AttributeBegin
    Material "mirror"
    Translate 1 1 0
    Rotate -90 0 1 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1, 1 0 -1, 1 0 1, -1 0 1 ]
AttributeEnd

# --- Glass sphere ---
AttributeBegin
    Material "glass"
    Translate 0.35 -0.4 0.0
    Shape "sphere"
        "float radius" [0.15]
AttributeEnd

# --- 3DGS object ---
AttributeBegin
    Material "gsmat"
    Scale 0.4 0.4 0.4
    Shape "gaussiancloud"
        "string filename" ["assets/lego/point_cloud.ply"]
        "float sigma_cutoff" [2.828]
        "bool use_center_depth" [true]
        "string internal_accel" ["bvh"]
AttributeEnd

# --- Area light ---
AttributeBegin
    Material "white"
    AreaLightSource "diffuse"
        "rgb L" [15 15 15]
    Translate 0 1.98 0
    Shape "bilinearmesh"
        "point3 P" [ -0.2 0 -0.2, 0.2 0 -0.2, 0.2 0 0.2, -0.2 0 0.2 ]
AttributeEnd