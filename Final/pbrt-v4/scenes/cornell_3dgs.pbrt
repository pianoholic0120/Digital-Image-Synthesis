# Cornell Box + 3DGS + mirror + glass (paper GI demo)

Film "rgb"
    "string filename" ["cornell_3dgs.exr"]
    "integer xresolution" [800] "integer yresolution" [800]

Sampler "halton"
    "integer pixelsamples" [128]

Integrator "path"

Accelerator "bvh"

LookAt 0 0 5.5  0 0 0  0 1 0
Camera "perspective"
    "float fov" [40]

WorldBegin

MakeNamedMaterial "white"
    "string type" ["diffuse"]
    "rgb reflectance" [0.725 0.71 0.68]
MakeNamedMaterial "red"
    "string type" ["diffuse"]
    "rgb reflectance" [0.63 0.065 0.05]
MakeNamedMaterial "green"
    "string type" ["diffuse"]
    "rgb reflectance" [0.14 0.45 0.091]
MakeNamedMaterial "mirror"
    "string type" ["conductor"]
    "rgb reflectance" [0.9 0.9 0.9]
    "float roughness" [0.001]
MakeNamedMaterial "glass"
    "string type" ["dielectric"]
    "float eta" [1.5]
    "float roughness" [0.0]
MakeNamedMaterial "gsmat"
    "string type" ["gaussian"]
    "integer sh_degree" [3]

AttributeBegin
    NamedMaterial "white"
    Translate 0 0.01 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1  1 0 -1  1 0 1  -1 0 1 ]
AttributeEnd

AttributeBegin
    NamedMaterial "white"
    Translate 0 2 0
    Rotate 180 1 0 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1  1 0 -1  1 0 1  -1 0 1 ]
AttributeEnd

AttributeBegin
    NamedMaterial "white"
    Translate 0 1 -1
    Rotate 90 1 0 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1  1 0 -1  1 0 1  -1 0 1 ]
AttributeEnd

AttributeBegin
    NamedMaterial "red"
    Translate -1 1 0
    Rotate 90 0 1 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1  1 0 -1  1 0 1  -1 0 1 ]
AttributeEnd

AttributeBegin
    NamedMaterial "mirror"
    Translate 1 1 0
    Rotate -90 0 1 0
    Shape "bilinearmesh"
        "point3 P" [ -1 0 -1  1 0 -1  1 0 1  -1 0 1 ]
AttributeEnd

AttributeBegin
    NamedMaterial "glass"
    Translate 0.35 -0.4 0.0
    Shape "sphere"
        "float radius" [0.15]
AttributeEnd

AttributeBegin
    NamedMaterial "gsmat"
    Scale 0.4 0.4 0.4
    Shape "gaussiancloud"
        "string filename" ["assets/lego/point_cloud.ply"]
        "float sigma_cutoff" [2.828]
        "integer sh_degree" [3]
        "bool use_center_depth" [false]
        "string sampling_mode" ["stochastic"]
        "string internal_accel" ["bvh"]
AttributeEnd

LightSource "distant"
    "rgb L" [1 1 1]
    "float scale" [3]
    "point3 from" [0.2 -1 -0.3]
    "point3 to" [0 0 0]
