# Depth-of-field test with 3DGS foreground

Film "rgb"
    "string filename" ["dof_scene.exr"]
    "integer xresolution" [800] "integer yresolution" [800]

Sampler "halton"
    "integer pixelsamples" [128]

Integrator "path"

Accelerator "bvh"

LookAt 0 1 6  0 0.5 0  0 1 0
Camera "perspective"
    "float fov" [40]
    "float lensradius" [0.05]
    "float focaldistance" [2.5]

WorldBegin

Material "diffuse" "gray"
    "rgb reflectance" [0.5 0.5 0.5]
Material "gaussian" "gsmat"
    "integer sh_degree" [3]

# Background spheres
AttributeBegin
    Material "gray"
    Translate -1.5 0.5 -2
    Shape "sphere" "float radius" [0.5]
AttributeEnd
AttributeBegin
    Material "gray"
    Translate 1.5 0.5 -2
    Shape "sphere" "float radius" [0.5]
AttributeEnd

# Foreground 3DGS
AttributeBegin
    Material "gsmat"
    Translate 0 0.5 0
    Shape "gaussiancloud"
        "string filename" ["assets/lego/point_cloud.ply"]
        "float sigma_cutoff" [2.828]
AttributeEnd

LightSource "distant"
    "rgb scale" [3 3 3]
    "vector3 direction" [0.3 -1 -0.2]