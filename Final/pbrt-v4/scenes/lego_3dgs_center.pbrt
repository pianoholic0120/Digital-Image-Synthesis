# Ablation: OursCenter (Sec 3.1 / 4.1) — depth = center projection onto ray

Film "rgb"
    "string filename" ["lego_3dgs_center.exr"]
    "integer xresolution" [800] "integer yresolution" [800]

Sampler "halton"
    "integer pixelsamples" [64]

Integrator "path"

Accelerator "bvh"

LookAt 0 2.737260103225708 2.959291696548462  0 2.0582295060157776 2.225181818008423  0 -0.7341099977493286 0.6790306568145752
Camera "perspective"
    "float fov" [39.597755335771296]

WorldBegin

Material "gaussian"
    "integer sh_degree" [3]

AttributeBegin
    Material "gaussian"
        "integer sh_degree" [3]
    Shape "gaussiancloud"
        "string filename" ["assets/lego/point_cloud.ply"]
        "float sigma_cutoff" [2.828]
        "integer sh_degree" [3]
        "bool use_center_depth" [true]
        "string sampling_mode" ["stochastic"]
        "string internal_accel" ["bvh"]
AttributeEnd
