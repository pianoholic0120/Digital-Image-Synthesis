Film "rgb" "string filename" ["test.exr"] "integer xresolution" [64] "integer yresolution" [64]
Sampler "halton" "integer pixelsamples" [1]
Integrator "path" "integer maxdepth" [0]

LookAt 0 2 6.0   0 1 0   0 1 0
Camera "perspective" "float fov" [45]

WorldBegin
LightSource "infinite" "rgb L" [0.5 0.5 0.5]

AttributeBegin
    Material "diffuse" "rgb reflectance" [0.5 0.5 0.5]
    Shape "disk" "float radius" [1]
AttributeEnd
