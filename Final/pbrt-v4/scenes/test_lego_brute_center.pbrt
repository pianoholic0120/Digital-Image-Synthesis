# Single-pixel validation: brute composite vs Python reference at frame-0 center.
Film "rgb"
    "string filename" ["test_lego_brute_center.exr"]
    "integer xresolution" [800] "integer yresolution" [800]

Sampler "halton"
    "integer pixelsamples" [1]

Integrator "path"

Accelerator "bvh"

LookAt -0.000000000 2.737260103 2.959291697  -0.000000000 2.058229446 2.225181818  -0.000000000 -0.734109998 0.679030597
Camera "perspective"
    "float fov" [39.597755335771296]

WorldBegin

Material "gaussian"
    "integer sh_degree" [3]

AttributeBegin
    Material "gaussian"
        "integer sh_degree" [3]
    Shape "gaussiancloud"
        "string filename" ["assets/3dgs/lego/point_cloud/iteration_30000/point_cloud.ply"]
        "float sigma_cutoff" [2.828]
        "integer sh_degree" [3]
        "bool use_center_depth" [true]
        "string sampling_mode" ["composite"]
        "string internal_accel" ["brute"]
        "rgb background" [1 1 1]
AttributeEnd
