*~
.#*
#*#
src/build
.DS_Store
.ipynb_checkpoints/
.cache/

# Build outputs (root .gitignore also covers Final/pbrt-v4/build*)
*build*/

# Render / benchmark outputs
renders/
results/

# Debug / trace logs
*.log
trace_*.log
malformed.txt

# --- scenes/ (report repo: only GI demos + asset metadata on GitHub) ---
# Ignore everything at scenes root except the two GI showcase scenes.
scenes/*
!scenes/gi_drjohnson_teapot.pbrt
!scenes/gi_mic_mirror.pbrt
!scenes/assets/

# Asset metadata only (PLY/OBJ/renders stay local).
scenes/assets/**/point_cloud/
scenes/assets/**/test/
scenes/assets/**/*.obj
scenes/assets/**/*.png
scenes/assets/**/cfg_args
scenes/assets/props/*
!scenes/assets/props/teapot_clean.ply

# Auto-generated scratch (regenerate via scripts/)
scenes/benchmark/
scenes/tandt_db/
scenes/3dgs/

# Python cache under scripts (keep .py source tracked)
scripts/__pycache__/
