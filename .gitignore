# macOS
.DS_Store
Icon?

# Build output (不 commit 編譯產物)
pbrt-v4/build/
Final/pbrt-v4/build/
Final/pbrt-v4/build-gpu/

# Large 3DGS assets (point clouds stay local; small teapot prop is tracked)
Final/pbrt-v4/scenes/assets/**/point_cloud/
Final/pbrt-v4/scenes/assets/**/*.ply
!Final/pbrt-v4/scenes/assets/props/teapot_clean.ply

# Benchmark logs (JSON results are tracked)
Final/report_results/*.log
Final/report_results/.benchmark.lock

# Render outputs
*.exr
Final/pbrt-v4/renders/

# gaussian-splatting: ignore build/training outputs (source is committed)
Final/gaussian-splatting/output/
Final/gaussian-splatting/**/__pycache__/
Final/gaussian-splatting/**/*.egg-info/
Final/gaussian-splatting/**/build/
Final/gaussian-splatting/**/dist/
Final/gaussian-splatting/tensorboard_3d/
Final/gaussian-splatting/screenshots/

# raytracing 書本 HTML release (整個 repo 可以用 submodule 管理，或視需要加)
# 若要 commit 則移除下一行
raytracing.github.io-release/

# 一般忽略
*.o
*.a
*.so
*.dylib
*.exe
*.bin

sample/
